    "test:unit:watch": "vitest",
    "test:e2e": "cypress run",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@primevue/themes": "^4.3.3",
    "axios": "^1.7.9",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.5",
    "tailwindcss-primeui": "^0.4.0",
    "unplugin-vue-components": "^28.0.0",
    "vue": "^3.5.26",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.2.5",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.20",
    "cypress": "^15.18.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.1",
    "prettier": "3.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
