{
  "kind": "collectionType",
  "collectionName": "cat_sheets",
  "info": {
    "singularName": "cat-sheet",
    "pluralName": "cat-sheets",
    "displayName": "CatSheet"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "cats": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cat.cat"
    },
    "linkedVolunteer": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "isDuo": {
      "type": "boolean"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "backupVolunteer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "cat_sheets"
    }
  }
}
