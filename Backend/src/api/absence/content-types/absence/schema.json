{
  "kind": "collectionType",
  "collectionName": "absences",
  "info": {
    "singularName": "absence",
    "pluralName": "absences",
    "displayName": "Absence"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "startDate": {
      "type": "datetime",
      "required": true
    },
    "endDate": {
      "type": "datetime",
      "required": true
    },
    "reason": {
      "type": "string"
    },
    "absence_status": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "absences"
    }
  }
}
